pipeline {
    agent any

    environment {
        AWS_REGION = credentials('AWS-REGION')
        ECR_REPO   = credentials('ECR_REPO_FE')
    }

    stages {

        stage('Build and Deploy Frontend') {
            when {
                expression {
                    return sh(
                        returnStatus: true, 
                        script: "git diff --name-only HEAD~1 HEAD | grep -q '^frontend/'"
                    ) == 0
                }
            }

            stages {

                stage('1. Checkout Code') {
                    steps {
                        echo "Checking out source code..."
                        checkout scm
                    }
                }

                stage('2. Prepare IMAGE_TAG') {
                    steps {
                        dir('frontend') {
                            script {
                                env.IMAGE_TAG = sh(
                                    returnStdout: true, 
                                    script: "git rev-parse --short HEAD"
                                ).trim()
                                echo "Using commit hash ${env.IMAGE_TAG} as Docker tag"
                            }
                        }
                    }
                }

                stage('3. Build Docker Image') {
                    steps {
                        dir('frontend') {
                            echo "Building Docker image..."
                            sh "docker build -t $ECR_REPO:$IMAGE_TAG ."
                        }
                    }
                }

                stage('4. Trivy Scan Image') {
                    steps {
                        dir('frontend') {
                            echo "Scanning Docker image with Trivy..."
                            sh """
                                docker run --rm \
                                    -v \$(pwd):/workspace \
                                    -v /var/run/docker.sock:/var/run/docker.sock \
                                    aquasec/trivy image \
                                    --format template \
                                    --template "@contrib/html.tpl" \
                                    --output /workspace/trivy-report.html \
                                    $ECR_REPO:$IMAGE_TAG
                            """
                        }
                    }
                }

                stage('5. Authenticate ECR') {
                    steps {
                        echo "Authenticating to ECR..."
                        sh """
                            aws ecr get-login-password --region $AWS_REGION | \
                                docker login --username AWS --password-stdin $ECR_REPO
                        """
                    }
                }

                stage('6. Push Docker Image to ECR') {
                    steps {
                        echo "Pushing Docker image to ECR..."
                        sh "docker push $ECR_REPO:$IMAGE_TAG"
                    }
                }

                stage('7. Update Deployment Manifest') {
                    steps {

                        dir('manifests/frontend') {
                            script {
                                echo "Updating deployment.yaml with new image tag ${IMAGE_TAG}"

                                sh """
                                    sed -i 's#image: ${ECR_REPO}:.*#image: ${ECR_REPO}:${IMAGE_TAG}#' deployment.yaml
                                    grep 'image:' deployment.yaml
                                """
                            }
                        }

                        script {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jenkins-token-github', 
                                    usernameVariable: 'GIT_USER', 
                                    passwordVariable: 'GIT_TOKEN'
                                )
                            ]) {
                                sh '''
                                    git config user.email "jenkins@ci.com"
                                    git config user.name "Jenkins CI"

                                    git add manifests/frontend/deployment.yaml
                                    git commit -m "Update frontend image tag to ${IMAGE_TAG}" || echo "No changes to commit"

                                    git push https://$GIT_USER:$GIT_TOKEN@github.com/TrongDuong2706/lab-cicd-k8s.git HEAD:uat
                                '''
                            }
                        }
                    }
                }

            }
        }
    }

    post {
        always {
            echo "Frontend pipeline completed."
            archiveArtifacts artifacts: 'frontend/trivy-report.html', fingerprint: true
        }
        success {
            echo "Frontend successfully pushed to ECR and manifest updated!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
